# Copy to .env.local for local development, and add the same keys as
# Vercel environment variables. Never commit real values.
# Synthetic data only: this prototype must never receive real patient data.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Model API: Groq, through its OpenAI-compatible endpoint.
# For the pilot, point these at Azure OpenAI in a UAE region instead.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Pick a current model from the Groq console. Set LLM_STRICT_SCHEMA=true only
# if that model supports strict json_schema output.
LLM_MODEL=
LLM_STRICT_SCHEMA=false
